    {
      "id": "ff30489a-ede3-42e2-9726-266f4dbee051",
      "name": "Find Broken Approved",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        224,
        220
      ],
      "parameters": {
        "resource": "record",
        "operation": "search",
        "authentication": "airtableTokenApi",
        "base": {

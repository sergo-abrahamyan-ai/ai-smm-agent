{
  "name": "SMM 3 - Daily Reels Publisher",
  "nodes": [
    {
      "id": "02254420-5cde-4227-a0e5-983e5132882f",
      "name": "Every Day 19:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        96
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 19 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "7f0945f6-79de-4c9d-af1c-91fc880a0843",
      "name": "Find Next Reel",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "resource": "record",
        "operation": "search",
        "authentication": "airtableTokenApi",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_BASE_ID"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_CONTENT_PLAN_TABLE_ID"
        },
        "filterByFormula": "AND({Format}='reel', {Status}='approved', {Image URL}!='', IS_BEFORE({Publish Date}, DATEADD(TODAY(), 1, 'days')))",
        "returnAll": false,
        "limit": 1,
        "sort": {
          "property": [
            {
              "field": "Publish Date",
              "direction": "asc"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1505cb5-35e5-4079-820d-6569d71cd6c7",
      "name": "Lock Reel",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "resource": "record",
        "operation": "update",
        "authentication": "airtableTokenApi",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_BASE_ID"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_CONTENT_PLAN_TABLE_ID"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.id }}",
            "Status": "publishing"
          },
          "matchingColumns": [
            "id"
          ],
          "schema": [
            {
              "id": "id",
              "displayName": "id",
              "required": false,
              "defaultMatch": true,
              "display": true,
              "type": "string",
              "readOnly": true,
              "removed": false
            },
            {
              "id": "Status",
              "displayName": "Status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {
          "typecast": true
        }
      }
    },
    {
      "id": "7b07aa4d-566d-49a0-9cfa-40d14d99b2fc",
      "name": "Create Reel Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "method": "POST",
        "url": "https://graph.instagram.com/v26.0/me/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ media_type: 'REELS', video_url: $('Find Next Reel').item.json.fields['Image URL'], caption: String($('Find Next Reel').item.json.fields.Caption || '').slice(0, 2150), share_to_feed: true }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "94a84a6e-e11c-4d46-97bd-da9c29fb994c",
      "name": "Wait 60s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        896,
        96
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 60,
        "unit": "seconds"
      }
    },
    {
      "id": "9ccad3a0-fd04-4e7d-b349-7a926fbfe0bb",
      "name": "Check Processing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        96
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://graph.instagram.com/v26.0/{{ $('Create Reel Container').item.json.id || 'missing' }}?fields=status_code,status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "309b4cac-0ab5-436e-9b16-7644272444c1",
      "name": "Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1344,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status_code }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "FINISHED"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "8b09c9bb-a718-48f3-b054-904efe45aa5d",
      "name": "Publish Reel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://graph.instagram.com/v26.0/me/media_publish",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ creation_id: $('Create Reel Container').item.json.id }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "disabled": false
    },
    {
      "id": "4bedf69d-6702-485a-9044-32cf3bc344ad",

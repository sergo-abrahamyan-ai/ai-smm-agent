      "typeVersion": 1.2,
      "position": [
        2688,
        96
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.fields?.Status === 'published' ? '🎬 Reels опубликован в Instagram' : '⚠️ Reels не опубликован' }}: {{ $('Find Next Reel').item.json.fields.Topic }}{{ $json.fields?.Status === 'published' ? '' : '\\nПричина: ' + ($json.fields?.['Post ID'] || '?') + '\\nПоставьте Status = approved, чтобы попробовать завтра в 19:00.' }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "onError": "continueRegularOutput",
      "disabled": false
    },
